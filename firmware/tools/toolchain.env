# Firmware toolchain pins: the single source of every pinned tool version,
# URL and checksum (AD-1, Story 2.1 Decision D1).
# Format: KEY=value, one per line, no quotes, no spaces around '='.
# Read by bash (set -a; . toolchain.env) and by CMake (file(STRINGS ... REGEX)).
# Changing a pin is its own PR (AD-1).

ARM_TOOLCHAIN_VERSION=15.2.Rel1
PICOTOOL_VERSION=2.3.1

# pico-sdk submodule (firmware/external/pico-sdk), tag 2.3.1, and its nested
# lib/tinyusb gitlink (TinyUSB 0.18.0). CI compares the checked-out HEADs to these.
PICO_SDK_TAG=2.3.1
PICO_SDK_COMMIT=079c6f39023649b154152db30f1d781e884879bc
TINYUSB_VERSION=0.18.0
TINYUSB_COMMIT=86ad6e56c1700e85f1c5678607a762cfe3aa2f47

# Arm GNU Toolchain 15.2.Rel1, arm-none-eabi, Linux x86_64 host (CI)
ARM_TOOLCHAIN_LINUX_X86_64_URL=https://developer.arm.com/-/media/Files/downloads/gnu/15.2.rel1/binrel/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi.tar.xz
ARM_TOOLCHAIN_LINUX_X86_64_SHA256=597893282ac8c6ab1a4073977f2362990184599643b4c5ee34870a8215783a16

# Arm GNU Toolchain 15.2.Rel1, arm-none-eabi, macOS arm64 host (local)
ARM_TOOLCHAIN_DARWIN_ARM64_URL=https://developer.arm.com/-/media/Files/downloads/gnu/15.2.rel1/binrel/arm-gnu-toolchain-15.2.rel1-darwin-arm64-arm-none-eabi.tar.xz
ARM_TOOLCHAIN_DARWIN_ARM64_SHA256=1938a84b7105c192e3fb4fa5e893ba25f425f7ddab40515ae608cd40f68669a8

# picotool 2.3.1 prebuilt, raspberrypi/pico-sdk-tools release v2.3.1-0, Linux x86_64 (CI)
PICOTOOL_LINUX_X86_64_URL=https://github.com/raspberrypi/pico-sdk-tools/releases/download/v2.3.1-0/picotool-2.3.1-x86_64-lin.tar.gz
PICOTOOL_LINUX_X86_64_SHA256=878a1a1e7d8336b8be60300c7218f366d9790c0d3a211b181d6d172e80b1248e

# picotool 2.3.1 prebuilt, raspberrypi/pico-sdk-tools release v2.3.1-0, macOS (local)
PICOTOOL_DARWIN_ARM64_URL=https://github.com/raspberrypi/pico-sdk-tools/releases/download/v2.3.1-0/picotool-2.3.1-mac.zip
PICOTOOL_DARWIN_ARM64_SHA256=7bb3cea5d9f1b000fc758cf4b54774fda5c16a9899d342ef6b0c30138988793b
