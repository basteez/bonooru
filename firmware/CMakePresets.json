{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "fw-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "PICO_BOARD": "waveshare_rp2040_zero",
        "PICO_TOOLCHAIN_PATH": "$env{OCB_ARM_TOOLCHAIN}",
        "picotool_DIR": "$env{OCB_PICOTOOL_DIR}/picotool",
        "FETCHCONTENT_FULLY_DISCONNECTED": "ON"
      }
    },
    {
      "name": "fw-release",
      "displayName": "Firmware, release (UF2s for both boards)",
      "inherits": "fw-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "fw-debug",
      "displayName": "Firmware, debug (OCB_DEBUG_BUILD=1)",
      "inherits": "fw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OCB_DEBUG_BUILD": "ON"
      }
    },
    {
      "name": "fw-release-xip",
      "displayName": "Firmware, release, XIP controller (story 2.5 D2: RAM gate self-test, H.20)",
      "inherits": "fw-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OCB_CONTROLLER_RUN_FROM_RAM": "OFF" }
    },
    {
      "name": "fw-debug-timeline",
      "displayName": "Firmware, debug counters, optimised, built-in test melody (story 2.5 H.18)",
      "inherits": "fw-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OCB_DEBUG_BUILD": "ON",
        "OCB_DEBUG_TIMELINE": "ON"
      }
    },
    {
      "name": "fw-debug-hang0",
      "displayName": "Firmware, timeline flavour that hangs core 0 on the first note (story 2.5 H.2a)",
      "inherits": "fw-debug-timeline",
      "cacheVariables": { "OCB_DEBUG_HANG": "CORE0" }
    },
    {
      "name": "fw-debug-hang1",
      "displayName": "Firmware, timeline flavour that hangs core 1 on the first note (story 2.5 H.2b)",
      "inherits": "fw-debug-timeline",
      "cacheVariables": { "OCB_DEBUG_HANG": "CORE1" }
    },
    {
      "name": "host-tests",
      "displayName": "Host tests (native compiler, no pico-sdk)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "OCB_HOST_TESTS": "ON",
        "OCB_SANITIZE": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "fw-release", "configurePreset": "fw-release" },
    { "name": "fw-debug", "configurePreset": "fw-debug" },
    { "name": "fw-release-xip", "configurePreset": "fw-release-xip" },
    { "name": "fw-debug-timeline", "configurePreset": "fw-debug-timeline" },
    { "name": "fw-debug-hang0", "configurePreset": "fw-debug-hang0" },
    { "name": "fw-debug-hang1", "configurePreset": "fw-debug-hang1" },
    { "name": "host-tests", "configurePreset": "host-tests" }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
